+"""
+Host side of the 8-row dynamic tree verify (elpis exl3 patch 0006-tree-verify).
+
+The draft-side builder (ext 9008) writes one 192-byte record per round: the eight verify-row tokens (int64,
+row 0 = the anchor) followed by a 128-byte TreeDesc. The verify kernels (ext 3012 attention, ext 5109 GDN)
+read a host-checked copy of that TreeDesc from one static device buffer, and the commit (ext 5109 replay /
+conv rewind, ext 3013 K/V compaction and draft refresh) consumes the accepted root path through maps built
+here. Everything in this module is host arithmetic over plain ints and bytes; every check fails closed.
+
+TreeDesc (128 bytes): magic 0x54, version 1, n_rows 8, n_leaf, n_prog, kind (0 = chain shape, else 1), two
+zero bytes, parent i8[8] (row 0 = -1, else 0 <= parent < row), depth u8[8], anc_mask u8[8], leaf_of u8[8],
+leaves u8[8], prog u8[16], path u8[8][8] (path[r][j] = row of r's depth-j ancestor, 0xFF past depth[r]).
+"""
+
+from __future__ import annotations
+import os
+import struct
+
+ROWS = 8
+WINDOW = ROWS - 1
+DESC_BYTES = 128
+OUT_BYTES = 64 + DESC_BYTES
+DEV_BYTES = DESC_BYTES + 4 * ROWS
+MAGIC = 0x54
+VERSION = 1
+CONV_K = 4
+PAGE_SIZE = 256
+
+_PARENT = 8
+_DEPTH = 16
+_ANC = 24
+_LEAF_OF = 32
+_LEAVES = 40
+_PROG = 48
+_PATH = 64
+
+OP_ADV = 0
+OP_PEEK = 1
+OP_RELOAD = 2
+OP_REPLAY = 3
+
+
+def parse_switch(name: str, raw: str | None, default: bool) -> bool:
+    """A strict 0|1 switch: unset is `default`, "0" is off, "1" is on, anything else raises."""
+    if raw is None:
+        return default
+    if raw == "0":
+        return False
+    if raw == "1":
+        return True
+    raise ValueError(f"{name} must be 0 or 1, got {raw!r}")
+
+
+def switches(environ = os.environ) -> tuple[bool, bool]:
+    """
+    (EXL3_TREE, EXL3_TREE_FORCE_CHAIN). The dynamic tree is on unless EXL3_TREE=0; the test hook
+    EXL3_TREE_FORCE_CHAIN (default 0) is valid only with the tree on.
+    """
+    tree = parse_switch("EXL3_TREE", environ.get("EXL3_TREE"), True)
+    force_chain = parse_switch("EXL3_TREE_FORCE_CHAIN", environ.get("EXL3_TREE_FORCE_CHAIN"), False)
+    if force_chain and not tree:
+        raise ValueError("EXL3_TREE_FORCE_CHAIN=1 requires EXL3_TREE=1")
+    return tree, force_chain
+
+
+def chain_desc() -> bytes:
+    """The constant TreeDesc of the chain parent[r] = r - 1 (DESIGN.md §2.2 CHAIN)."""
+    d = bytearray(DESC_BYTES)
+    d[0:8] = bytes([MAGIC, VERSION, ROWS, 1, ROWS, 0, 0, 0])
+    d[_PARENT:_PARENT + ROWS] = bytes([0xFF] + list(range(ROWS - 1)))
+    d[_DEPTH:_DEPTH + ROWS] = bytes(range(ROWS))
+    d[_ANC:_ANC + ROWS] = bytes((1 << (r + 1)) - 1 for r in range(ROWS))
+    d[_LEAF_OF:_LEAF_OF + ROWS] = bytes([ROWS - 1] * ROWS)
+    d[_LEAVES:_LEAVES + ROWS] = bytes([ROWS - 1] + [0xFF] * (ROWS - 1))
+    d[_PROG:_PROG + 16] = bytes([(OP_ADV << 4) | r for r in range(ROWS)] + [0xFF] * 8)
+    for r in range(ROWS):
+        d[_PATH + 8 * r:_PATH + 8 * r + 8] = bytes([j if j <= r else 0xFF for j in range(ROWS)])
+    return bytes(d)
+
+
+CHAIN = chain_desc()
+CHAIN_PARENT = [-1] + list(range(ROWS - 1))
+
+
+class TreeRound:
+    """One round's checked builder output: tokens, parent, depth, root paths and the TreeDesc bytes."""
+    __slots__ = ("mode", "tokens", "parent", "depth", "paths", "desc")
+
+    def __init__(self, mode: int, tokens: list[int], parent: list[int], depth: list[int],
+                 paths: list[list[int]], desc: bytes):
+        self.mode = mode
+        self.tokens = tokens
+        self.parent = parent
+        self.depth = depth
+        self.paths = paths
+        self.desc = desc
+
+    @property
+    def is_tree(self) -> bool:
+        return self.mode == 1
+
+
+def _require(cond: bool, message: str):
+    if not cond:
+        raise RuntimeError(f"Tree verify: {message}")
+
+
+def check_output(raw: bytes, mode: int, anchor: int, derive) -> TreeRound:
+    """
+    Check one builder record against the host: tokens[0] is the anchor, every token id is non-negative,
+    mode 0 wrote CHAIN, mode 1 wrote exactly derive(parent) for a parent array with 0 <= parent[r] < r,
+    and children of one parent carry distinct tokens. Returns the parsed round.
+    """
+    _require(type(raw) is bytes and len(raw) == OUT_BYTES, "builder record must be 192 bytes")
+    _require(mode in (0, 1), f"builder mode must be 0 or 1, got {mode!r}")
+    tokens = list(struct.unpack("<8q", raw[:64]))
+    desc = raw[64:]
+    _require(tokens[0] == anchor, f"builder anchor {tokens[0]} differs from the committed anchor {anchor}")
+    _require(all(t >= 0 for t in tokens), "negative token id in the builder record")
+    parent = [b - 256 if b >= 128 else b for b in desc[_PARENT:_PARENT + ROWS]]
+    if mode == 0:
+        _require(desc == CHAIN, "mode-0 builder record is not CHAIN")
+    else:
+        _require(parent[0] == -1 and all(0 <= parent[r] < r for r in range(1, ROWS)),
+                 f"parent array {parent} is not parent-before-child")
+        expected = derive(parent)
+        _require(type(expected) is bytes and len(expected) == DESC_BYTES, "derive() returned a malformed TreeDesc")
+        _require(desc == expected, "builder TreeDesc differs from the proven derive(parent)")
+    children: dict[int, set[int]] = {}
+    for r in range(1, ROWS):
+        sib = children.setdefault(parent[r], set())
+        _require(tokens[r] not in sib, f"sibling rows under row {parent[r]} repeat token {tokens[r]}")
+        sib.add(tokens[r])
+    depth = list(desc[_DEPTH:_DEPTH + ROWS])
+    paths = []
+    for r in range(ROWS):
+        row = desc[_PATH + 8 * r:_PATH + 8 * r + 8]
+        p = list(row[:depth[r] + 1])
+        _require(p[0] == 0 and p[-1] == r and all(p[j] < p[j + 1] for j in range(len(p) - 1)),
+                 f"path of row {r} is not a root path")
+        paths.append(p)
+    return TreeRound(mode, tokens, parent, depth, paths, desc)
+
+
+def verify_bytes(desc: bytes, depth: list[int], base: int) -> bytes:
+    """The 160 bytes uploaded to the verify's static buffer: TreeDesc, then int32 positions base + depth."""
+    _require(len(desc) == DESC_BYTES and len(depth) == ROWS, "malformed TreeDesc")
+    _require(0 <= base and base + ROWS < (1 << 31), f"position base {base} out of range")
+    return desc + struct.pack("<8i", *[base + d for d in depth])
+
+
+def accepted_path(rnd: TreeRound, count: int, last: int) -> list[int]:
+    """Rows P[0..count) whose K/V and state the round commits: the root path of `last`, exactly count long."""
+    _require(1 <= count <= ROWS and 0 <= last < ROWS, f"acceptance returned count {count}, last {last}")
+    p = rnd.paths[last]
+    _require(len(p) == count, f"acceptance count {count} is not the depth of row {last} plus one")
+    return list(p)
+
+
+def committed_tokens(verify_ids: list[int], path: list[int]) -> list[int]:
+    """The target's greedy tokens along the path: the round's committed tokens, the last one the next anchor."""
+    return [verify_ids[r] for r in path]
+
+
+def is_identity(path: list[int]) -> bool:
+    return all(r == j for j, r in enumerate(path))
+
+
+def row_map(path: list[int]) -> bytes:
+    """Replay row map (16 bytes): the path, then identity for the unused steps."""
+    count = len(path)
+    _require(1 <= count <= ROWS and path[0] == 0 and all(path[j] < path[j + 1] for j in range(count - 1)),
+             f"replay rows {path} are not a root path")
+    return bytes(path + list(range(count, 16)))
+
+
+def src_off(path: list[int]) -> bytes:
+    """
+    Conv-window source offsets (4 bytes) relative to the chain rewind's source (p - cdim, p = state_size -
+    rejected). Window entry k is logical index L = count + k of [old0..3, x_P0 .. x_P(count-1)]; its index
+    in the verify's window sequence [old0..3, x_0..x_7] is L below 4, else 4 + P[L - 4]; the offset is that
+    index minus count. The chain gives 0, 1, 2, 3.
+    """
+    count = len(path)
+    _require(1 <= count <= ROWS and path[0] == 0, f"conv rows {path} are not a root path")
+    out = []
+    for k in range(CONV_K):
+        L = count + k
+        seq = L if L < CONV_K else CONV_K + path[L - CONV_K]
+        _require(1 <= seq <= CONV_K + WINDOW, f"conv window index {seq} outside the verify's written tail")
+        out.append(seq - count)
+    return bytes(out)
+
+def page_fixups(path: list[int], base: int, tokens: list[int]) -> list[tuple[int, int]]:
+    """(position, token) pairs that restore page.sequence to the committed tokens at the moved positions."""
+    return [(base + j, tokens[r]) for j, r in enumerate(path) if j and r != j]
+
+
+def apply_page_fixups(pages, fixups: list[tuple[int, int]]):
+    for pos, token in fixups:
+        page = pages[pos // PAGE_SIZE]
+        page.sequence[:, pos % PAGE_SIZE] = token
