+"""
+Admitted acceptance decision and descriptor derivation for 8-row greedy tree verification.
+
+Both are the Bend-proven tree leaves, compiled into a CPU library and admitted by their own loader (artifact
+identity plus an exhaustive differential against the Bend specification table) when the generator is
+constructed. This module only binds that loader; it never computes or approximates either result.
+"""
+
+from __future__ import annotations
+import importlib.util
+from collections.abc import Sequence
+from pathlib import Path
+import torch
+
+ACCEPTOR_DIR = Path("/opt/qwen/bend-exl3")
+ACCEPTOR_LOADER = ACCEPTOR_DIR / "exl3_bend_tree_accept.py"
+ROWS = 8
+
+
+def _ids(values: torch.Tensor | Sequence[int]) -> list[int]:
+    return values.tolist() if isinstance(values, torch.Tensor) else list(values)
+
+
+class TreeAccept:
+    """
+    Decide how many verifier tokens an 8-row greedy tree round commits, and derive the round's TreeDesc.
+
+    Row 0 is the anchor, rows 1..7 are the drafted nodes with parent[r] < r. The decision walks the maximal
+    matching path P from the root (repeatedly the lowest child whose token equals the current row's verify id) and
+    applies the chain rules (stop token, token budget, final row, recurrent checkpoint boundary) along it. Returns
+    (count, eos, last): verify_ids[P[i]] for i < count is committed, eos tells whether the last committed token
+    ends the job, and last = P[count - 1] is the row of the last committed token.
+    """
+
+    def __init__(self, window: int):
+        if window != ROWS - 1:
+            raise RuntimeError(f"Tree acceptance requires a {ROWS - 1}-token draft window, not {window}")
+        spec = importlib.util.spec_from_file_location("exl3_bend_tree_accept", ACCEPTOR_LOADER)
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"Tree acceptance loader is missing: {ACCEPTOR_LOADER}")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        self.acceptor = module.admit(str(ACCEPTOR_DIR))
+        self.request = module.TreeRequest
+
+
+    def accept_tree(
+        self,
+        verify_ids: torch.Tensor | Sequence[int],
+        tokens: torch.Tensor | Sequence[int],
+        parent: torch.Tensor | Sequence[int],
+        stop_tokens: set[int],
+        budget: int,
+        checkpoint: int,
+    ) -> tuple[int, bool, int]:
+        """
+        :param verify_ids:
+            Host int64 (8,), the target's greedy token for each verified row
+
+        :param tokens:
+            Host int64 (8,), row 0 = anchor, rows 1..7 = drafted tokens
+
+        :param parent:
+            (8,) parent rows: parent[0] = -1, 0 <= parent[r] < r
+
+        :param stop_tokens:
+            Token IDs that end the job
+
+        :param budget:
+            Tokens the job may still generate, >= 1
+
+        :param checkpoint:
+            Committed count in 1..7 at which a recurrent checkpoint boundary stops acceptance along the path, or 0
+        """
+        count, eos, last = self.acceptor.accept_tree(
+            self.request(
+                verify_ids=_ids(verify_ids),
+                tokens=_ids(tokens),
+                parents=_ids(parent),
+                stop_ids=tuple(sorted(stop_tokens)),
+                budget=budget,
+                checkpoint=checkpoint,
+            )
+        )
+        if (
+            type(count) is not int or type(eos) is not bool or type(last) is not int
+            or not 1 <= count <= ROWS or not 0 <= last < ROWS
+        ):
+            raise RuntimeError("Tree acceptance returned a malformed decision")
+        return count, eos, last
+
+
+    def derive(self, parent: torch.Tensor | Sequence[int]) -> bytes:
+        """
+        The 128-byte TreeDesc (DESIGN.md §2.2) of a legal parent array: parent[0] = -1, 0 <= parent[r] < r.
+        """
+        desc = self.acceptor.derive(_ids(parent))
+        if type(desc) is not bytes or len(desc) != 128:
+            raise RuntimeError("Tree descriptor derivation returned a malformed descriptor")
+        return desc
