+# Ext 5110h: merged 4096-row prefill forwards are bounded by memory. The largest transient of a prefill forward is the
+# quantized-cache attention staging scratch (modules/attention_fn/triton_paged.py): fp16 K and V over the job's whole
+# block table rounded up to a power of two in pages, 1 GiB at 1024 pages (<= 262144 tokens of prompt + generation
+# budget) and 2 GiB from 1025 pages on; a merged forward adds its extra 2048 rows of activations on top. The old 5110g
+# prompt bound (131072) came from a 262K OOM that was the test harness's own full-KV snapshot gather (0080g4/g5/g7,
+# fixed in 0080g8), not the engine. Merge only while the scratch is at most M4096_MAX_STAGE_PAGES pages; the prompt
+# bound M4096_MAX_PROMPT = 262143 (the served context minus the one generated token) excludes nothing on its own.
+# Measured (memory probe 0081zr on the p9502t test build, 350 W, 32 new tokens): 131122 tokens merged, 513 pages ->
+# 1024-page scratch: prefill and first verify round OK, min free 857 MiB; 262052 merged, 1024 pages: OK, min free
+# 537 MiB; 262136 unmerged, 1025 pages -> 2048-page scratch: min free 37 MiB; 262136 merged past the page bound: OOM.
+# Both constants are module globals read per chunk
+M4096_MAX_STAGE_PAGES = 1024
+M4096_MAX_PROMPT = 262143
+
+
+def m4096_stage_pages(block_table_pages: int) -> int:
+    """Pages of the attention staging scratch for a single-sequence block table (triton_paged.py's rounding)"""
+    return max(1, 1 << (block_table_pages - 1).bit_length())
 
 
