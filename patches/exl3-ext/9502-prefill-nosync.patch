+def prefill_nosync_enabled() -> bool:
+    """Ext 9502 kill switch EXL3_PREFILL_NOSYNC: unset or "1" = on, "0" = off, anything else is an error (read per
+    prefill call). On, a prefill chunk never blocks the host on the GPU: the chunk's block table, cache length and
+    embedded rows go up from pinned host memory without a stream synchronization, and the recurrent checkpoint taken
+    after it leaves its device-to-host copies in flight until the next iterate (cache/recurrent.py). The same kernels
+    and copies run in the same order on the same stream; only when the host waits changes."""
+    env = os.environ.get("EXL3_PREFILL_NOSYNC")
+    if env is None or env == "1":
+        return True
+    if env == "0":
+        return False
+    raise ValueError("EXL3_PREFILL_NOSYNC must be 0 or 1")
+
