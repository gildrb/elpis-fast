+"""
+Pipelined tree verify round (elpis-fast ext 9601, bend/tree_pipe*.bend).
+
+The sequential tree round (0006-tree-verify) waits for the draft, reads the builder record back, checks it
+(tree_round.check_output), uploads the verify descriptor and positions, embeds the row tokens on the host and
+only then launches the verify forward: the GPU idles from the end of the draft until the first verify kernel.
+
+Here the draft's stream also runs ext.tree_verify_stage right after the tree builder: it copies the record's
+TreeDesc into the verify's static buffer, writes the positions base + depth[r] and gathers the row tokens'
+embedding rows from the mapped host table, so the verify forward is launched while the draft still runs. A
+side stream reads back what the verify consumes (the 160 descriptor/position bytes and the embedded rows). After
+the launch the host runs the sequential round's own check on the record and compares the readback with the
+bytes the sequential round would have uploaded (tree_round.verify_bytes) and the rows its host embedding
+computes, bit for bit:
+- record rejected: the speculative verify is discarded and the round fails exactly as the sequential one;
+- readback differs: the speculative verify is discarded (no GDN commit, the recurrent state's position and
+  history restored, K/V rows past the committed position overwritten later) and the round is recomputed
+  through the sequential path;
+- equal: the verify consumed exactly the sequential round's inputs, so its outputs are the sequential
+  round's, and the round commits them.
+EXL3_TREE_PIPE strict 0|1 (default: on wherever the tree runs and the target embedding qualifies; 1 on a
+configuration that cannot run it fails construction). EXL3_TREE_PIPE_FAULT=k (test hook, default 0) adds 1 to
+the staged positions on every k-th staged round, so the verify consumes a wrong buffer and the discard path
+runs.
+"""
+
+from __future__ import annotations
+import torch
+from ..ext import exllamav3_ext as ext
+from ..modules.embedding import Embedding
+from . import tree_round
+
+# cudaHostRegisterPortable | cudaHostRegisterMapped; cudaErrorHostMemoryAlreadyRegistered
+_HOST_REGISTER_FLAGS = 3
+_ALREADY_REGISTERED = 712
+
+
+def switches(environ, tree: bool) -> tuple[bool | None, int]:
+    """
+    (EXL3_TREE_PIPE, EXL3_TREE_PIPE_FAULT). The pipe is None when unset (on where supported), True / False
+    when set; the fault period is a non-negative int (0 = off) and needs the pipe.
+    """
+    raw = environ.get("EXL3_TREE_PIPE")
+    pipe = None if raw is None else tree_round.parse_switch("EXL3_TREE_PIPE", raw, False)
+    raw_fault = environ.get("EXL3_TREE_PIPE_FAULT")
+    fault = 0
+    if raw_fault is not None:
+        if not raw_fault.isdigit() or raw_fault != str(int(raw_fault)):
+            raise ValueError(f"EXL3_TREE_PIPE_FAULT must be a non-negative integer, got {raw_fault!r}")
+        fault = int(raw_fault)
+    if pipe and not tree:
+        raise ValueError("EXL3_TREE_PIPE=1 requires the tree verify (EXL3_TREE=1)")
+    if fault and (pipe is False or not tree):
+        raise ValueError("EXL3_TREE_PIPE_FAULT requires the tree pipe")
+    return pipe, fault
+
+
+def target_embedding(model, device: torch.device) -> Embedding | str:
+    """
+    The target's input Embedding when the device stage reproduces its host path exactly and the first block
+    runs on the tree buffers' device, else why not.
+    """
+    if getattr(model, "loaded_tp", False):
+        return "requires a target loaded without tensor parallelism"
+    emb = model.modules[0] if len(model.modules) > 1 else None
+    if type(emb) is not Embedding or emb.embedding is None:
+        return "requires the target's first module to be its Embedding"
+    if torch.device(model.modules[1].device) != torch.device(device):
+        return "requires the target's first block on the tree buffers' device"
+    weight = emb.embedding.weight
+    if (
+        emb.normalize or emb.multiplier != 1.0 or emb.out_dtype != torch.float or weight.device.type != "cpu" or
+        weight.dim() != 2 or not weight.is_contiguous() or weight.dtype not in (torch.half, torch.bfloat16, torch.float)
+    ):
+        return "requires a plain host-resident half / bfloat16 / float32 embedding with float32 output"
+    return emb
+
+
+class Staged:
+    """One round staged on the device: builder mode, position base, the verify's input rows, readback event."""
+    __slots__ = ("mode", "base", "x", "ids", "checked", "fault")
+
+    def __init__(self, mode: int, base: int, x: torch.Tensor, ids: torch.Tensor, checked: torch.cuda.Event,
+                 fault: bool):
+        self.mode = mode
+        self.base = base
+        self.x = x
+        self.ids = ids
+        self.checked = checked
+        self.fault = fault
+
+
+class TreePipe:
+
+    def __init__(self, emb: Embedding, tree_out: torch.Tensor, tree_dev: torch.Tensor, fault: int):
+        weight = emb.embedding.weight.data
+        rc = int(torch.cuda.cudart().cudaHostRegister(
+            weight.data_ptr(), weight.numel() * weight.element_size(), _HOST_REGISTER_FLAGS))
+        if rc not in (0, _ALREADY_REGISTERED):
+            raise RuntimeError(f"Tree pipe: cudaHostRegister of the target embedding failed ({rc})")
+        self.emb = emb
+        self.table = weight
+        self.hidden = emb.hidden_size
+        self.tree_out = tree_out
+        self.tree_dev = tree_dev
+        self.tree_pos = tree_dev[tree_round.DESC_BYTES:].view(torch.int32)
+        dev = tree_out.device
+        rows = tree_round.ROWS
+        # The row tokens of the record as the verify's (1, 8) input ids (shape only: forward reads the rows)
+        self.ids = tree_out[0, :8 * rows].view(torch.long).view(1, rows)
+        self.rows = torch.empty((rows, self.hidden), dtype = torch.float, device = dev)
+        self.dev_pinned = torch.zeros((tree_round.DEV_BYTES,), dtype = torch.uint8, pin_memory = True)
+        self.rows_pinned = torch.zeros((rows, self.hidden), dtype = torch.float, pin_memory = True)
+        self.stream = torch.cuda.Stream(dev)
+        self.fault = fault
+        self.layers = {}
+        self.conv = {}
+        self.staged_rounds = 0
+        self.recomputed_rounds = 0
+
+
+    def stage(self, mode: int, base: int) -> Staged:
+        """Launch the device stage of this round on the current stream (after the builder) and its readback."""
+        if not (0 <= base and base + 255 < (1 << 31)):
+            raise RuntimeError(f"Tree pipe: position base {base} out of range")
+        x = torch.empty((1, tree_round.ROWS, self.hidden), dtype = torch.float, device = self.tree_out.device)
+        ext.tree_verify_stage(self.tree_out, base, self.table, self.tree_dev, x.view(tree_round.ROWS, self.hidden),
+                              self.rows)
+        self.staged_rounds += 1
+        fault = self.fault > 0 and self.staged_rounds % self.fault == 0
+        if fault:
+            self.tree_pos.add_(1)
+        main = torch.cuda.current_stream(x.device)
+        staged = torch.cuda.Event()
+        staged.record(main)
+        self.stream.wait_event(staged)
+        with torch.cuda.stream(self.stream):
+            self.dev_pinned.copy_(self.tree_dev, non_blocking = True)
+            self.rows_pinned.copy_(self.rows, non_blocking = True)
+            checked = torch.cuda.Event()
+            checked.record(self.stream)
+        return Staged(mode, base, x, self.ids, checked, fault)
+
+
+    def same(self, staged: Staged, rnd: tree_round.TreeRound) -> bool:
+        """
+        Whether the verify consumed exactly the sequential round's inputs for the checked record rnd: the
+        uploaded bytes tree_round.verify_bytes(desc, depth, base) and the host embedding of the row tokens,
+        bit for bit. The caller has synchronized on staged.checked.
+        """
+        expect = tree_round.verify_bytes(rnd.desc, rnd.depth, staged.base)
+        if self.dev_pinned.numpy().tobytes() != expect:
+            return False
+        rows = self.emb.forward(torch.tensor([rnd.tokens], dtype = torch.long), {})
+        if rows.dtype != torch.float or tuple(rows.shape) != (1, tree_round.ROWS, self.hidden):
+            raise RuntimeError("Tree pipe: the host embedding returned an unexpected tensor")
+        return torch.equal(rows.view(tree_round.ROWS, self.hidden).view(torch.int32), self.rows_pinned.view(torch.int32))
+
+
+    def _layers(self, state) -> list:
+        key = id(state.cache)
+        layers = self.layers.get(key)
+        if layers is None:
+            layers = list(state.cache.get_all_recurrent_layers().values())
+            self.layers[key] = layers
+        return layers
+
+
+    def _conv_jobs(self, state) -> tuple[int, list, list]:
+        """
+        (device index, save jobs, restore jobs) for the conv window conv_state[slot, :, :cdim] of every GDN layer:
+        a history verify rewrites the whole conv buffer (the window head included: the buffer holds
+        cdim + max_history columns and the verify writes its last min(cdim + max_history, cdim + seqlen)
+        inputs), so a discarded verify must restore the committed window from a copy taken before it ran.
+        Jobs for ext.batched_conv_rewind (same per-channel stride; save buffers allocated once per layer).
+        """
+        key = (id(state.cache), state.slot)
+        entry = self.conv.get(key)
+        layers = self._layers(state)
+        addrs = tuple(layer.conv_state.data_ptr() for layer in layers)
+        if entry is not None and entry[0] == addrs:
+            return entry[1]
+        devices = {torch.device(layer.device).index for layer in layers}
+        if len(devices) != 1:
+            raise RuntimeError("Tree pipe: the GDN layers must share one device")
+        save_jobs, restore_jobs, keep = [], [], []
+        for layer in layers:
+            cs = layer.conv_state
+            if cs.dim() != 3 or cs.stride(2) != 1:
+                raise RuntimeError("Tree pipe: unexpected GDN conv state layout")
+            buf = torch.empty((cs.shape[1], cs.stride(1)), dtype = cs.dtype, device = cs.device)
+            es = cs.element_size()
+            head = cs.data_ptr() + state.slot * cs.stride(0) * es
+            cdim = layer.module.conv_kernel_size
+            save_jobs.append(ext.ConvRewindJob(head, buf.data_ptr(), cs.shape[1], cdim, cs.stride(1)))
+            restore_jobs.append(ext.ConvRewindJob(buf.data_ptr(), head, cs.shape[1], cdim, cs.stride(1)))
+            keep.append(buf)
+        jobs = (devices.pop(), save_jobs, restore_jobs)
+        self.conv[key] = (addrs, jobs, keep)
+        return jobs
+
+
+    def snapshot(self, state) -> tuple:
+        """
+        The state a verify forward changes for the GDN state `state` (see discard); launches the copy of every
+        layer's committed conv window on the current stream, ahead of the speculative verify.
+        """
+        layers = self._layers(state)
+        slot = state.slot
+        if any(slot in layer.pending for layer in layers):
+            raise RuntimeError("Tree pipe: a pending GDN verify precedes the staged round")
+        device, save_jobs, _ = self._conv_jobs(state)
+        ext.batched_conv_rewind(save_jobs, device)
+        return state, state.position, state.last_history, [layer for layer in layers if slot in layer.flushed]
+
+
+    def discard(self, snap: tuple):
+        """
+        Undo the speculative verify forward: no layer holds its verify as pending (nothing is replayed:
+        recurrent row 0 still holds the committed state), every layer's conv window is restored from the copy
+        snapshot() took (stream-ordered after the speculative verify), the flushed set and the state's position
+        and history are as before. Its K/V rows past the committed position, the conv buffer's history columns
+        and its per-layer statics are scratch that the recompute overwrites before reading.
+        """
+        state, position, last_history, flushed = snap
+        for layer in self._layers(state):
+            layer.pending.pop(state.slot, None)
+        device, _, restore_jobs = self._conv_jobs(state)
+        ext.batched_conv_rewind(restore_jobs, device)
+        for layer in flushed:
+            layer.flushed.add(state.slot)
+        state.position = position
+        state.last_history = last_history
+        self.recomputed_rounds += 1
