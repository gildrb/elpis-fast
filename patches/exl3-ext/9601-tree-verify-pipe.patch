+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include "tree_pipe.cuh"
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "util.h"
+#include "util.cuh"
+
+// ext 9601: see tree_pipe.cuh. Grid (CEIL(hidden / 256), 8): block (bx, r) gathers columns
+// bx * 256 + t of row r; block (0, 0) also writes the 160-byte verify buffer (threads 0..127 the
+// TreeDesc bytes, threads 0..7 the positions). Every output element is written by exactly one
+// thread, from inputs no thread writes.
+
+#define TREE_PIPE_ROWS 8
+#define TREE_PIPE_TOKEN_BYTES 64     // the record's 8 int64 row tokens
+#define TREE_PIPE_DESC_BYTES 128     // TreeDesc, at record offset 64
+#define TREE_PIPE_DEPTH 16           // TreeDesc depth u8[8] offset
+#define TREE_PIPE_REC_BYTES (TREE_PIPE_TOKEN_BYTES + TREE_PIPE_DESC_BYTES)
+#define TREE_PIPE_DEV_BYTES (TREE_PIPE_DESC_BYTES + 4 * TREE_PIPE_ROWS)
+#define TREE_PIPE_THREADS 256
+
+template <typename in_t> __device__ __forceinline__ float tree_pipe_widen(in_t v);
+template <> __device__ __forceinline__ float tree_pipe_widen<half>(half v) { return __half2float(v); }
+template <> __device__ __forceinline__ float tree_pipe_widen<__nv_bfloat16>(__nv_bfloat16 v) { return __bfloat162float(v); }
+template <> __device__ __forceinline__ float tree_pipe_widen<float>(float v) { return v; }
+
+template <typename in_t>
+__global__ __launch_bounds__(TREE_PIPE_THREADS)
+void tree_verify_stage_kernel
+(
+    const uint8_t* __restrict__ rec,
+    const int base,
+    const in_t* __restrict__ table,
+    const int64_t vocab,
+    const int hidden,
+    uint8_t* __restrict__ dev,
+    float* __restrict__ x,
+    float* __restrict__ rows
+)
+{
+    const int r = blockIdx.y;
+    const int t = threadIdx.x;
+    if (blockIdx.x == 0 && r == 0)
+    {
+        if (t < TREE_PIPE_DESC_BYTES)
+            dev[t] = rec[TREE_PIPE_TOKEN_BYTES + t];
+        if (t < TREE_PIPE_ROWS)
+            reinterpret_cast<int*>(dev + TREE_PIPE_DESC_BYTES)[t] =
+                base + (int) rec[TREE_PIPE_TOKEN_BYTES + TREE_PIPE_DEPTH + t];
+    }
+
+    const int c = blockIdx.x * TREE_PIPE_THREADS + t;
+    if (c >= hidden) return;
+    const int64_t id = reinterpret_cast<const int64_t*>(rec)[r];
+    const bool valid = 0 <= id && id < vocab;
+    const float v = valid ? tree_pipe_widen<in_t>(table[id * (int64_t) hidden + c]) : 0.0f;
+    x[(int64_t) r * hidden + c] = v;
+    rows[(int64_t) r * hidden + c] = v;
+}
+
+void tree_verify_stage
+(
+    const at::Tensor& rec,
+    int64_t base,
+    const at::Tensor& table,
+    const at::Tensor& dev,
+    const at::Tensor& x,
+    const at::Tensor& rows
+)
+{
+    TORCH_CHECK(rec.is_cuda() && rec.dtype() == at::kByte && rec.is_contiguous() && rec.numel() == TREE_PIPE_REC_BYTES,
+                "tree_verify_stage: rec must be a contiguous CUDA uint8 tensor of ", TREE_PIPE_REC_BYTES, " bytes");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(rec.data_ptr()) % 8 == 0, "tree_verify_stage: rec is not 8-byte aligned");
+    TORCH_CHECK(dev.is_cuda() && dev.dtype() == at::kByte && dev.is_contiguous() && dev.numel() == TREE_PIPE_DEV_BYTES,
+                "tree_verify_stage: dev must be a contiguous CUDA uint8 tensor of ", TREE_PIPE_DEV_BYTES, " bytes");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(dev.data_ptr()) % 4 == 0, "tree_verify_stage: dev is not 4-byte aligned");
+    TORCH_CHECK(table.device().is_cpu() && table.dim() == 2 && table.is_contiguous(),
+                "tree_verify_stage: table must be a contiguous 2D CPU tensor in mapped pinned memory");
+    TORCH_CHECK(table.dtype() == at::kHalf || table.dtype() == at::kBFloat16 || table.dtype() == at::kFloat,
+                "tree_verify_stage: table must be half, bfloat16 or float32");
+    const int64_t vocab = table.size(0);
+    const int64_t hidden = table.size(1);
+    TORCH_CHECK(hidden > 0 && hidden <= (1 << 20), "tree_verify_stage: unsupported hidden size ", hidden);
+    for (const at::Tensor* t : {&x, &rows})
+    {
+        TORCH_CHECK(t->is_cuda() && t->dtype() == at::kFloat && t->is_contiguous() && t->dim() == 2 &&
+                    t->size(0) == TREE_PIPE_ROWS && t->size(1) == hidden,
+                    "tree_verify_stage: x and rows must be contiguous CUDA float32 [8, hidden] tensors");
+        TORCH_CHECK(t->device() == rec.device(), "tree_verify_stage: x and rows must be on rec's device");
+    }
+    TORCH_CHECK(dev.device() == rec.device(), "tree_verify_stage: dev must be on rec's device");
+    TORCH_CHECK(x.data_ptr() != rows.data_ptr(), "tree_verify_stage: x and rows must be distinct buffers");
+    TORCH_CHECK(base >= 0 && base + 255 < ((int64_t) 1 << 31), "tree_verify_stage: position base ", base, " out of range");
+
+    const c10::cuda::CUDAGuard device_guard(rec.device());
+    // The mapped storage must be addressable from this device (UVA: the host address itself)
+    cudaPointerAttributes attr;
+    const cudaError_t attr_error = cudaPointerGetAttributes(&attr, table.data_ptr());
+    TORCH_CHECK(attr_error == cudaSuccess, "tree_verify_stage: cudaPointerGetAttributes(table): ", cudaGetErrorString(attr_error));
+    TORCH_CHECK(attr.type == cudaMemoryTypeHost && attr.devicePointer != nullptr,
+                "tree_verify_stage: table storage is not registered as mapped pinned memory");
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    dim3 blocks((unsigned) CEIL_DIVIDE(hidden, (int64_t) TREE_PIPE_THREADS), TREE_PIPE_ROWS);
+    #define TREE_PIPE_LAUNCH(in_t) \
+        tree_verify_stage_kernel<in_t><<<blocks, TREE_PIPE_THREADS, 0, stream>>>( \
+            (const uint8_t*) rec.data_ptr(), (int) base, (const in_t*) attr.devicePointer, vocab, (int) hidden, \
+            (uint8_t*) dev.data_ptr(), (float*) x.data_ptr(), (float*) rows.data_ptr())
+    if (table.dtype() == at::kHalf) TREE_PIPE_LAUNCH(half);
+    else if (table.dtype() == at::kBFloat16) TREE_PIPE_LAUNCH(__nv_bfloat16);
+    else TREE_PIPE_LAUNCH(float);
+    #undef TREE_PIPE_LAUNCH
+    cuda_check(cudaPeekAtLastError());
+}
