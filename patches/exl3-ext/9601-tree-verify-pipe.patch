+#pragma once
+
+#include <ATen/Tensor.h>
+#include <cstdint>
+
+// ext 9601 (tree pipe): device staging of one 8-row tree verify round, so the verify forward is
+// launched straight after the draft, without reading the builder record back first.
+//
+// rec: the tree builder's record (ext 9008), CUDA uint8 [1, 192]: the 8 row tokens as int64
+// (row 0 the anchor), then the 128-byte TreeDesc. One launch writes, in stream order after the
+// builder:
+// - dev, CUDA uint8 [160]: dev[i] = rec[64 + i] for i < 128 (the TreeDesc), then int32
+//   pos[r] = base + rec[64 + 16 + r] for r < 8 (row position = base + depth[r]): the 160 bytes
+//   the host's tree_round.verify_bytes(desc, depth, base) uploads in the sequential round;
+// - x and rows, CUDA float32 [8, hidden]: row r = table[token r] widened to float32 (exact), the
+//   target embedding's host-path output for the row tokens. x feeds the verify (its residual
+//   stream is updated in place); rows is the copy the host reads back and checks. Both get
+//   the same value from the same load.
+// table: the target embedding, a contiguous CPU [vocab, hidden] half / bfloat16 / float32 tensor
+// whose storage is registered as mapped pinned memory (read over the bus with its device
+// pointer). A token outside [0, vocab) writes zero rows; the host check rejects such a record
+// (the sequential round raises on it) before anything is committed.
+// base: 0 <= base and base + 255 < 2^31 (checked), so every int32 position equals the Nat sum.
+void tree_verify_stage
+(
+    const at::Tensor& rec,
+    int64_t base,
+    const at::Tensor& table,
+    const at::Tensor& dev,
+    const at::Tensor& x,
+    const at::Tensor& rows
+);
