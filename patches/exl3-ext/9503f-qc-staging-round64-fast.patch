+# compact arange block table, keys below cache_seqlens + kv_append_len (the rest are zero-filled cp.async with an
+# in-range address); the Triton fallback takes num_pages_per_seq from block_table.shape[1]. So the launches, their
+# arguments and every byte they read are unchanged; only the allocation shrinks. Kill switch
+# EXL3_QC_STAGING_ROUND64, read per call: unset or "1" = multiples of 64 pages, "0" = power of two, else an error
+QC_STAGING_ROUND_PAGES = 64
