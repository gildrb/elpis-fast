+# run's first verify round exceeded the card (0080g4 / 0080g5: 23.17 GiB allocated, OOM; 131073 tokens peaked at
+# 22.36 GiB either way); longer prompts keep the 2048-row schedule, so their memory and outputs are unchanged
+M4096_MAX_PROMPT = 131072
 
+
+def prefill_m4096_enabled() -> bool:
+    """Ext 5110 kill switch EXL3_PREFILL_M4096: unset or "1" = on, "0" = off, anything else is an error
+    (read per chunk, so one process can A/B it)."""
+    env = os.environ.get("EXL3_PREFILL_M4096")
+    if env is None or env == "1":
+        return True
+    if env == "0":
+        return False
+    raise ValueError("EXL3_PREFILL_M4096 must be 0 or 1")
